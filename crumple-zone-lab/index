  limb(sh,elbow,.066,.045);limb(elbow,hand,.045,.029);
  disc(...sh,.058,'#7d898d','#374750');disc(...sh,.041,'#a9afb0','#44555e');
  disc(...sh,.025,'#65757e','#35464e');disc(...sh,.009,'#b7bec0','#3f4c54');
  disc(...elbow,.027,'#8b9696','#3c4c53');disc(...elbow,.013,'#3d474b');
  disc(hand[0]+.045,hand[1]-.01,.031,'#7d898d','#39464e');
  disc(hand[0]+.045,hand[1]-.01,.014,'#495a63','#b8bfbd');
  line([[hand[0]+.007,hand[1]-.023],[hand[0]+.012,hand[1]+.025]],'#252f36',.024);
  poly([[hand[0]+.008,hand[1]-.026],[hand[0]-.04,hand[1]-.02],[hand[0]-.07,hand[1]+.018],[hand[0]-.08,hand[1]+.05],[hand[0]-.053,hand[1]+.062],[hand[0]-.014,hand[1]+.04],[hand[0]+.014,hand[1]+.022]],'#f0b938');
  for(let k=0;k<3;k++)line([[hand[0]-.065,hand[1]+.04-k*.014],[hand[0]-.034,hand[1]+.02-k*.014]],'#ab7923',.004);
  if(cfg.belt){
    line([[seatX+.28,hipY+.56],[sh[0]-.08,sh[1]-.055],[hipX-.09,hipY+.03]],'#1c2d3c',.038);
    line([[seatX+.28,hipY+.56],[sh[0]-.08,sh[1]-.055],[hipX-.09,hipY+.03]],'#536371',.023);
  }
  }
