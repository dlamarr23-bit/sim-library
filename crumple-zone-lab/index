  const poly=(points,fill,stroke='#7c571c',width=.008)=>{
    ctx.beginPath();points.forEach(([x,y],i)=>i?ctx.lineTo(...P(x,y)):ctx.moveTo(...P(x,y)));ctx.closePath();
