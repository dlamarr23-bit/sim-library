const illustrationPaths = new Map();
function illustrationPoints(data){
  if (illustrationPaths.has(data)) return illustrationPaths.get(data);
  const t=data.match(/[MLQCZ]|-?\d*\.?\d+/g), points=[];
  let i=0,x=0,y=0,start;
  while(i<t.length){
    const op=t[i++];
    if(op==='Z'){points.push(start);continue;}
    const n=op==='C'?6:op==='Q'?4:2, a=t.slice(i,i+n).map(Number);i+=n;
    if(op==='M'){x=a[0];y=a[1];start=[x,y];if(points.length)points.push(null);points.push(start);continue;}
    const ex=a[n-2],ey=a[n-1];
    const steps=Math.max(2,Math.ceil((Math.hypot(ex-x,ey-y)+(n>2?Math.hypot(a[0]-x,a[1]-y):0))/6));
    for(let j=1;j<=steps;j++){
      const u=j/steps,v=1-u;
      if(op==='L')points.push([x+(ex-x)*u,y+(ey-y)*u]);
      if(op==='Q')points.push([v*v*x+2*v*u*a[0]+u*u*ex,v*v*y+2*v*u*a[1]+u*u*ey]);
      if(op==='C')points.push([v*v*v*x+3*v*v*u*a[0]+3*v*u*u*a[2]+u*u*u*ex,v*v*v*y+3*v*v*u*a[1]+3*v*u*u*a[3]+u*u*u*ey]);
    }
    x=ex;y=ey;
  }
  illustrationPaths.set(data,points);return points;
}

function drawCar(ctx,o){
  const {st,Lz,crush,ref,dir,X,Y,ppm}=o;
  const kind=st===STYLES.suv?'suv':st===STYLES.subcompact?'subcompact':'sedan';
  const art=CAR_ART[kind],scale=st.L/1000,outline='#172f47',paint=o.paint||st.paint;
  const def=makeDeform(Lz,crush),wx=x=>ref+dir*def(x);
  const damage=crashShape(st,Lz,crush),fold=damage.hoodFold,damageSpan=damage.hoodEnd;
  const motion=o.motion||{pitch:0,heave:0,rearLift:0};
  const cabinHeight=(x,h)=>h+motion.heave+(def(x)-st.L*.55)*motion.pitch;
  const height=(x,y)=>cabinHeight(x,(430-y)*scale)+damage.panelOffset(x,y);
  const P=(x,y)=>[X(ref+dir*damage.panelX(x*scale,def)),Y(height(x*scale,y))];
  // The seat and person do not inherit the hood's sheet-metal buckling.
  o.bodyHeight=cabinHeight;
  o.damage=damage;
  const trace=(data,append=false)=>{
    if(!append)ctx.beginPath();let pen=false;
    for(const point of illustrationPoints(data)){
      if(!point){pen=false;continue;}
      if(pen)ctx.lineTo(...P(...point));else ctx.moveTo(...P(...point));pen=true;
    }
    if(data.trim().endsWith('Z'))ctx.closePath();
  };
  const path=(data,fill,stroke=outline,width=2)=>{
    trace(data);if(fill){ctx.fillStyle=fill;ctx.fill();}
    if(stroke){ctx.strokeStyle=stroke;ctx.lineWidth=Math.max(.55,width*scale*ppm);ctx.stroke();}
  };
  const gradient=(top,bottom,y0=55,y1=385)=>{
    const g=ctx.createLinearGradient(0,P(0,y0)[1],0,P(0,y1)[1]);g.addColorStop(0,top);g.addColorStop(1,bottom);return g;
  };
  const color=value=>paint[value]||value;
  const layers=list=>{for(const layer of list)path(layer.path,layer.fill?color(layer.fill):null,layer.stroke?color(layer.stroke):null,layer.width);};
  const bounds=data=>{
    const points=illustrationPoints(data).filter(Boolean);
    return {left:Math.min(...points.map(p=>p[0])),right:Math.max(...points.map(p=>p[0])),top:Math.min(...points.map(p=>p[1])),bottom:Math.max(...points.map(p=>p[1]))};
  };
  ctx.save();ctx.lineJoin='round';ctx.lineCap='round';
  if(o.foregroundOnly){
    // Even-odd holes preserve the view through the glass while keeping the
    // complete near-side frame opaque. Reuse the same deformed illustration.
    trace(art.body);trace(art.glass,true);
    art.pillars.forEach(pillar=>trace(pillar,true));
    ctx.clip('evenodd');
  }
  ctx.save();ctx.globalAlpha=.21;ctx.fillStyle='#243246';ctx.beginPath();
  ctx.ellipse(X(ref+dir*(st.L+crush)/2),Y(.012),(st.L-crush)*ppm*.52,ppm*.045,0,0,Math.PI*2);ctx.fill();ctx.restore();
  drawCarWheels(ctx,o,wx);
  layers(art.roofRails);
  path(art.body,gradient(paint.light,paint.base),outline,3.2);
  ctx.save();trace(art.body);ctx.clip();
  layers(art.layers);
  if(kind!=='suv')for(const axle of [st.fw,st.rw]){
    const x=axle/scale,r=st.wr/scale+9,y=430-st.wr/scale;
    path(`M ${x-r} ${y+4} C ${x-r-3} ${y-r*1.36} ${x+r+3} ${y-r*1.36} ${x+r} ${y+4}`,null,paint.shade,11);
    path(`M ${x-r-7} ${y-12} C ${x-r-3} ${y-r*1.46} ${x+r+3} ${y-r*1.46} ${x+r+7} ${y-12}`,null,'rgba(235,249,255,.2)',3);
  }
  ctx.restore();
  // Each opening follows the reference, including the SUV's separate cargo glazing.
  path(art.glass,gradient('#b2d9ec','#d8eff6',55,210),outline,6.5);
  path(art.glass,null,'#5e7484',1.8);
  ctx.save();trace(art.glass);ctx.clip();
  art.seats.forEach((seat,i)=>path(seat,i?'#728a9b':'#526675','#394e60',1.4));
  path('M 424 35 L 452 35 L 319 218 L 284 218 Z','rgba(255,255,255,.32)',null);
  path('M 642 37 L 680 43 L 558 210 L 520 211 Z','rgba(255,255,255,.34)',null);
  path('M 704 51 L 729 60 L 619 207 L 594 210 Z','rgba(255,255,255,.19)',null);
  path('M 831 51 L 856 61 L 760 204 L 738 206 Z','rgba(255,255,255,.15)',null);
  if(o.hideOccupant){
    path('M 296 175 L 329 128 L 358 143 L 381 112 L 404 142 L 392 179 L 349 204 Z','rgba(36,57,74,.30)',null);
    path('M 349 162 L 309 137 M 349 162 L 376 112 M 349 162 L 407 171 M 349 162 L 328 205 M 349 162 L 376 192 M 349 162 L 320 171',null,'#edfaff',2);
  }
  if(o.dummy)drawDummy(ctx,o,wx);
  for(const pillar of art.pillars){path(pillar,gradient('#405768','#2d4354',50,205),'#213649',1.5);}
  ctx.restore();
  path(art.glass,null,outline,2.1);
  path(art.frontDoor,null,'#283d4e',1.5);path(art.rearDoor,null,'#283d4e',1.5);
  path(art.hood,null,paint.edge,1.7);
  for(const handle of art.handles){
    const {x,y,w}=handle,h=w*.16;
    path(`M ${x-w*.32} ${y-h*.4} Q ${x} ${y-h*1.7} ${x+w*.3} ${y-h*.6}`,paint.shade,null);
    path(`M ${x-w*.45} ${y-h*.15} L ${x+w*.43} ${y-h*.5} Q ${x+w*.56} ${y-h*.1} ${x+w*.43} ${y+h*.45} L ${x-w*.44} ${y+h*.65} Q ${x-w*.57} ${y+h*.4} ${x-w*.45} ${y-h*.15} Z`,gradient(paint.light,paint.base,y-h,y+h),outline,1.6);
    path(`M ${x-w*.35} ${y} L ${x+w*.35} ${y-h*.2}`,null,'rgba(250,255,255,.28)',1.2);
  }
  if(art.fuel){const {x,y,r,rect}=art.fuel;path(rect?`M ${x-r} ${y-r*.7} Q ${x-r} ${y-r} ${x-r*.7} ${y-r} L ${x+r*.7} ${y-r} Q ${x+r} ${y-r} ${x+r} ${y-r*.7} L ${x+r} ${y+r*.7} Q ${x+r} ${y+r} ${x+r*.7} ${y+r} L ${x-r*.7} ${y+r} Q ${x-r} ${y+r} ${x-r} ${y+r*.7} Z`:`M ${x-r} ${y} C ${x-r} ${y-r*1.33} ${x+r} ${y-r*1.33} ${x+r} ${y} C ${x+r} ${y+r*1.33} ${x-r} ${y+r*1.33} ${x-r} ${y} Z`,null,paint.edge,1.5);}
  path(art.headlight,crush>.22?'#2b3b47':kind==='subcompact'?'#95a7b2':'#eef3f2',outline,2.2);
  ctx.save();trace(art.headlight);ctx.clip();ctx.globalAlpha=1-Math.min(.85,Math.max(0,crush-.14)*2);layers(art.details);ctx.restore();
  path(art.taillight,gradient('#ff5b50','#cc3435',175,285),outline,2.2);
  const tail=bounds(art.taillight);
  ctx.save();trace(art.taillight);ctx.clip();
  const lensTop=tail.top+(tail.bottom-tail.top)*.72;
  path(`M ${tail.left-5} ${tail.top+3} L ${tail.right+5} ${tail.top+3} L ${tail.right+5} ${tail.top+11} L ${tail.left-5} ${tail.top+11} Z`,'rgba(255,152,126,.35)',null);
  if(kind!=='subcompact')path(`M ${tail.left-5} ${lensTop} L ${tail.right+5} ${lensTop} L ${tail.right+5} ${tail.bottom+5} L ${tail.left-5} ${tail.bottom+5} Z`,'#ebeeec','#87939b',1.2);
  ctx.restore();
  path(art.mirror,gradient(paint.light,paint.base,150,210),outline,2.3);
  const mirror=bounds(art.mirror),split=mirror.top+(mirror.bottom-mirror.top)*.68;
  ctx.save();trace(art.mirror);ctx.clip();
  path(`M ${mirror.left-2} ${split} L ${mirror.right+2} ${split-2} L ${mirror.right+2} ${mirror.bottom+3} L ${mirror.left-2} ${mirror.bottom+3} Z`,'#344c5d',null);ctx.restore();
  if(crush>.035){
    // A few fixed fold lines sharpen as metal collapses. No traveling sine-wave.
    ctx.save();trace(art.body);ctx.clip();const end=damageSpan/scale;
    for(let k=0;k<3;k++){
      const x=end*(.28+k*.22),depth=fold*(12+k*3);
      ctx.globalAlpha=fold*.8;
      path(`M ${x-12} 233 L ${x+depth} 266 L ${x-depth*.35} 305 L ${x+5} 344`,null,paint.edge,1.2+fold);
      path(`M ${x-9} 233 L ${x+depth+3} 266 L ${x-depth*.35+3} 305`,null,'rgba(255,255,255,.55)',1.2);
    }
    // Highlight the hood hinge and the dark seam immediately underneath it.
    ctx.globalAlpha=fold;
    path(art.hood,null,'#273a48',2.2+fold*1.6);
    ctx.restore();
    if(damage.cell>.06){
      ctx.save();trace(art.glass);ctx.clip();ctx.globalAlpha=Math.min(1,damage.cell*3);
      path('M 321 183 L 354 162 L 377 174 M 354 162 L 349 132 M 354 162 L 380 143 M 354 162 L 338 197',null,'rgba(247,253,255,.9)',1.3);
      ctx.globalAlpha=damage.cabinFold;
      path('M 433 95 L 480 123 L 512 96 M 480 123 L 471 177 L 510 199 M 480 123 L 538 148 L 570 128 M 538 148 L 558 186',null,'#f3fbff',2);
      ctx.restore();
      ctx.save();trace(art.body);ctx.clip();ctx.globalAlpha=damage.cabinFold*.85;
      path('M 332 220 L 380 251 L 354 296 L 400 355 M 386 220 L 431 263 L 412 312 L 451 355',null,paint.edge,2.6);
      path('M 338 220 L 386 252 L 360 295 L 406 350',null,'rgba(245,253,255,.65)',1.6);
      ctx.restore();
    }
  }
  ctx.restore();
}


function drawCarWheels(ctx,o,wx){
  const {st,X,Y,ppm}=o;
  for(const x of [st.fw,st.rw]){
    const radius=st.wr*ppm;
    const front=x===st.fw,damage=o.damage||crashShape(st,o.Lz,o.crush);
    const shift=front?Math.max(damage.wheelShift,o.crush+st.wr*1.03-makeDeform(o.Lz,o.crush)(x)):0;
    const flat=front?damage.wheelDamage*.13:0,lift=front?0:(o.motion?.rearLift||0);
    ctx.save();
    // A displaced wheel and its well must remain behind the bumper, including
    // when mirrored for the opposing car or the crumple zone is exhausted.
    const nose=X(o.ref+o.dir*o.crush),rear=X(o.ref+o.dir*(st.L+2));
    ctx.beginPath();ctx.rect(Math.min(nose,rear),-10000,Math.abs(rear-nose),20000);ctx.clip();
    ctx.translate(X(wx(x)+o.dir*shift),Y(st.wr*(1-flat)+lift));
    // A recessed wheel well keeps the background from showing around the tire.
