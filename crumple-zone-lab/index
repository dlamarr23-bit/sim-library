function drawDummy(ctx,o,wx){
  const {st,X,Y,ppm,fr,cfg}=o;
  const s=Math.max(-.05,Math.min(.8,fr.sd));
  const hipX=st.hip-(cfg.belt?0:s*.48), hipY=st===STYLES.suv?.85:st===STYLES.subcompact?.66:.79;
  const ang=-.46+Math.asin(Math.max(-.3,Math.min(.94,s*(cfg.belt?1:.6)/.48)));
  const P=(x,y)=>[X(wx(x)),Y(o.bodyHeight?o.bodyHeight(x,y):y)];
