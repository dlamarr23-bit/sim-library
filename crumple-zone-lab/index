  };
  const rig=pose.rig||flyingDummyRig(pose.age);
  for(const part of rig.limbs)limb(part.a,part.b,part.w);
  for(const p of rig.joints)joint(...p);
  ctx.fillStyle='#353f44';ctx.strokeStyle='#1c303f';ctx.lineWidth=.008;
  for(let k=0;k<5;k++){ctx.beginPath();ctx.roundRect(-.045,-.43-k*.017,.09,.015,.006);ctx.fill();ctx.stroke();}
  ctx.beginPath();
  illustrationPoints(DUMMY_HEAD_PATH).forEach(([x,y],i)=>{const px=(x-60)*.0023,py=-.76+y*.0023;i?ctx.lineTo(px,py):ctx.moveTo(px,py)});ctx.closePath();
  const yellow=ctx.createLinearGradient(-.12,-.7,.12,-.5);yellow.addColorStop(0,'#ffe07b');yellow.addColorStop(1,'#e8a828');ctx.fillStyle=yellow;ctx.fill();ctx.strokeStyle='#79531b';ctx.lineWidth=.008;ctx.stroke();
  ctx.beginPath();ctx.arc(.03,-.645,.052,0,7);ctx.fillStyle='#ffd25b';ctx.fill();ctx.strokeStyle='#263846';ctx.lineWidth=.006;ctx.stroke();
  ctx.fillStyle='#202d37';for(const angle of [0,Math.PI]){ctx.beginPath();ctx.moveTo(.03,-.645);ctx.arc(.03,-.645,.049,angle,angle+Math.PI/2);ctx.closePath();ctx.fill();}
