    if(!ej.landed){const previous=ejectionPose(r,Math.max(r.ejection.t,fr.t-.055));ctx.save();ctx.strokeStyle='rgba(235,194,73,.35)';ctx.lineWidth=Math.max(1,ppm*.035);ctx.beginPath();ctx.moveTo(X(previous.x),Y(previous.y));ctx.lineTo(X(ej.x),Y(ej.y));ctx.stroke();ctx.restore();}
