  poly([[seatX+.21,hipY+.43],[seatX+.22,hipY+.64],[seatX+.24,hipY+.70],[seatX+.28,hipY+.72],[seatX+.34,hipY+.71],[seatX+.38,hipY+.67],[seatX+.38,hipY+.45]],'#566a7c','#1b3145');
  line([[seatX+.25,hipY+.48],[seatX+.26,hipY+.65],[seatX+.29,hipY+.68]],'#8396a4',.008);
  if(!o.hideOccupant){
  // Molded torso, broad chest, narrower waist and a separate shaded flank.
  shape([[-.09,-.03],[-.15,.1],[-.17,.31],[-.13,.48],[-.07,.55],[.055,.56],[.13,.45],[.14,.24],[.1,.01]],'#e9af2f');
  shape([[.05,.54],[.13,.45],[.14,.24],[.1,.01],[.04,.01],[.055,.29]],'#c78a1e',null);
  shape([[-.13,.13],[-.15,.32],[-.11,.46],[-.065,.5],[-.08,.36],[-.085,.12]],'#ffda66',null);
  line([body(.015,.02),body(.045,.24),body(.025,.48)],'#9d6b1c',.005);
  const headAngle=ang+.46+Math.max(-.1,Math.min(.24,(fr.uD-fr.u)*.018)), neckBase=body(0,.62), base=[neckBase[0]-.11,neckBase[1]];
  // The flexible neck stays connected between the shoulder and the upright head.
  const neckBottom=[sh[0]-.045,sh[1]+.018],neckTop=[base[0]+.058,base[1]+.045];
  for(let k=0;k<6;k++){
    const a=k/6,b=(k+1)/6;
