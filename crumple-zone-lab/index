    ctx.fillStyle='#f3f5ef';ctx.fill();ctx.strokeStyle='#9aaeba';ctx.lineWidth=Math.max(1,ppm*.007);ctx.stroke();
  }
  ctx.restore();
}

function drawFlyingDummy(ctx,pose,X,Y,ppm){
  ctx.save();ctx.translate(X(pose.x),Y(pose.y));ctx.rotate(pose.angle);ctx.scale(ppm,ppm);
  ctx.lineJoin='round';ctx.lineCap='round';
  const joint=(x,y,r=.045)=>{ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle='#77848a';ctx.fill();ctx.strokeStyle='#293e4b';ctx.lineWidth=.009;ctx.stroke();ctx.beginPath();ctx.arc(x,y,r*.35,0,7);ctx.fillStyle='#c3c9c6';ctx.fill();};
  const limb=(a,b,width)=>{
    ctx.beginPath();ctx.moveTo(...a);ctx.lineTo(...b);ctx.lineWidth=width+.018;ctx.strokeStyle='#76521b';ctx.stroke();
    const g=ctx.createLinearGradient(a[0],a[1],b[0]+.1,b[1]);g.addColorStop(0,'#ffd365');g.addColorStop(1,'#d99420');
    ctx.lineWidth=width;ctx.strokeStyle=g;ctx.stroke();
