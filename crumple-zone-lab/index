  if (!r.two){
    const bx0=X(-1.4), bx1=X(0), by=Y(1.25);
    ctx.fillStyle=C.concrete; ctx.fillRect(bx0,by,bx1-bx0,groundY-by);
    ctx.save(); ctx.beginPath(); ctx.rect(bx1-.12*ppm,by,.12*ppm,groundY-by); ctx.clip();
    const sw=.12*ppm; for(let yy=by-sw*2; yy<groundY+sw; yy+=sw){ ctx.fillStyle=C.accent; ctx.beginPath(); ctx.moveTo(bx1-sw,yy); ctx.lineTo(bx1,yy-sw*.6); ctx.lineTo(bx1,yy-sw*.6+sw*.5); ctx.lineTo(bx1-sw,yy+sw*.5); ctx.fill(); }
    ctx.restore();
    ctx.fillStyle=C['accent-ink']; ctx.globalAlpha=.25; ctx.fillRect(bx1-.12*ppm,by,.12*ppm,groundY-by); ctx.globalAlpha=1;
  }
  const motion=bodyMotion(fr.t,r.contactT,r.impactSpeed/24);
  if (r.two){
    // The opposing driver is illustrative; measurements remain for car 1's dummy.
    const age=r.contactT===null?-1:fr.t-r.contactT;
    const lean=age<0?0:Math.min(.32,r.impactClosing/32*.34)*Math.max(0,Math.sin(age*18))*Math.exp(-age*4);
    drawCar(ctx, {st:STYLES.sedan, Lz:CAR2.L, crush:fr.c2, ref:fr.p2, dir:-1, paint:{base:'#DAAD61',light:'#FFE0A0',shade:'#A77A36',edge:'#715526'}, X, Y, ppm, dist:fr.p2 - r.p2_0, dummy:true, fr:{...fr,sd:lean,u:fr.w2,uD:fr.w2+lean*10,infl:0}, cfg:{belt:true,bag:false}, motion:bodyMotion(fr.t,r.contactT,(r.impactClosing-r.impactSpeed)/24)});
  }
  const primaryCar={st,Lz:r.Lz,crush:fr.c1,ref:fr.p1,dir:1,X,Y,ppm,dist:fr.p1-r.p1_0,dummy:true,hideOccupant:!!ej,impactSpeed:r.impactSpeed,fr,cfg:r.cfg,motion};
  drawCar(ctx,primaryCar);
  // Short-lived impact dust comes from the damaged nose and settles with gravity.
  if(r.crashed&&fr.t>=r.contactT){
    const age=fr.t-r.contactT, strength=Math.min(1,r.impactClosing/25);
    if(age<1.1&&strength>0){
      ctx.save();
      for(let k=0;k<9;k++){
        const a=Math.max(0,age-k*.01),rad=(.03+a*(.28+k*.021))*ppm;
        ctx.globalAlpha=Math.max(0,(1-age/1.1))*.075*strength;
        const dust=ctx.createRadialGradient(X(front1),Y(.5),0,X(front1),Y(.5),Math.max(1,rad*2));dust.addColorStop(0,C.muted);dust.addColorStop(1,'rgba(130,140,145,0)');
        ctx.fillStyle=dust;ctx.beginPath();
        ctx.ellipse(X(front1+.04+Math.sin(k*7)*a*.5),Y(.25+k*.055+a*.4),rad*1.5,rad,0,0,Math.PI*2);ctx.fill();
      }
      ctx.restore();
    }
  }
  // debris
  for (const p of r.parts){
    if (p.t > fr.t) continue;
    const dt = fr.t - p.t, tl = (p.vy + Math.sqrt(p.vy*p.vy + 2*9.8*p.y))/9.8;
    const after=Math.max(0,dt-tl),bounceV=(9.8*tl-p.vy)*.22;
    const px=p.x+p.vx*Math.min(dt,tl)+p.vx*.16*(1-Math.exp(-after*5));
    const py=dt<tl?p.y+p.vy*dt-4.9*dt*dt:Math.max(p.s*.15,bounceV*after-4.9*after*after);
    ctx.fillStyle=p.col==='car1'?st.paint.base:p.col==='car2'?'#DAAD61':p.col==='glass'?'#b9dfec':C.concrete;
    ctx.save(); ctx.translate(X(px),Y(py)); ctx.rotate(p.vx*Math.min(dt,tl+.1)*3);
    ctx.beginPath();ctx.moveTo(-p.s*ppm*.6,-p.s*ppm*.4);ctx.lineTo(p.s*ppm*.6,p.panel?-p.s*ppm*.18:0);ctx.lineTo(p.s*ppm*.32,p.s*ppm*.4);ctx.lineTo(-p.s*ppm*.4,p.s*ppm*.2);ctx.closePath();ctx.fill();
    if(p.panel){ctx.strokeStyle='#29435a';ctx.lineWidth=Math.max(1,ppm*.007);ctx.stroke();ctx.strokeStyle='rgba(240,251,255,.5)';ctx.beginPath();ctx.moveTo(-p.s*ppm*.4,-p.s*ppm*.2);ctx.lineTo(p.s*ppm*.4,-p.s*ppm*.1);ctx.stroke();}ctx.restore();
  }
  if(ej){
    ctx.save();ctx.fillStyle='#28323e';ctx.globalAlpha=ej.landed?.23:.13;ctx.beginPath();ctx.ellipse(X(ej.x),Y(.01),ppm*.82,ppm*.035,0,0,Math.PI*2);ctx.fill();ctx.restore();
