  line(rim,'#1e303f',.023);line([[wheel[0]-.025,wheel[1]+.065],[wheel[0]+.025,wheel[1]-.065]],'#778796',.006);
  if(!o.hideOccupant){
  const hand=[Math.min(wheel[0]+.03,sh[0]-.17),wheel[1]+.035];
