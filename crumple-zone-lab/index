/* ---------------- overview strip ---------------- */
const ov = $('overview'), octx = ov.getContext('2d');
function drawOverview(){
  if (!run) return;
  const { w:W, h:H, dpr } = fitCanvas(ov), ctx=octx, r=run, fr=frameAt(T);
  const xmin = r.two ? r.p2_0 - 6 : -3, xmax = r.p1_0 + r.st.L + 2;
  const k = W/(xmax-xmin), X = x => (x - xmin)*k;
  ctx.fillStyle = C.sky; ctx.fillRect(0,0,W,H*.42);
  ctx.fillStyle = C.asphalt; ctx.fillRect(0,H*.42,W,H*.58);
  ctx.fillStyle = C['asphalt-line']; for (let x=Math.ceil(xmin/4)*4; x<xmax; x+=4) ctx.fillRect(X(x), H*.7, 2*k, Math.max(2,H*.06));
  ctx.fillStyle = C.muted; ctx.font = `700 ${10*dpr}px Poppins, system-ui, sans-serif`; ctx.textBaseline='top';
  for (let x=Math.ceil(xmin/10)*10; x<xmax; x+=10) ctx.fillText(x+' m', X(x)+2, 2*dpr);
  if (!r.two){ ctx.fillStyle=C.concrete; ctx.fillRect(X(-1.4), H*.12, X(0)-X(-1.4), H*.6); ctx.fillStyle=C.accent; ctx.fillRect(X(0)-Math.max(2,dpr*2), H*.12, Math.max(2,dpr*2), H*.6); }
  const mini = (front, len, dir, col) => {
    const x0 = X(front), x1 = X(front + dir*len); const a=Math.min(x0,x1), b=Math.max(x0,x1);
    const h = H*.26, y = H*.72 - h;
    ctx.fillStyle = col; ctx.beginPath(); ctx.roundRect ? ctx.roundRect(a,y,b-a,h,3*dpr) : ctx.rect(a,y,b-a,h); ctx.fill();
    ctx.fillStyle='#1b1e22'; ctx.beginPath(); ctx.arc(a+(b-a)*.2,H*.72,h*.32,0,7); ctx.arc(a+(b-a)*.8,H*.72,h*.32,0,7); ctx.fill();
  };
  if (r.two) mini(fr.p2 - fr.c2, STYLES.sedan.L - fr.c2, -1, '#DAAD61');
  mini(fr.p1 + fr.c1, r.st.L - fr.c1, 1, r.st.paint.base);
}

/* ---------------- readouts ---------------- */
function updateReadouts(){
  if (!run) return;
  const fr = frameAt(T);
  $('roTime').textContent = fr.t.toFixed(3) + ' s';
  $('roSpeed').textContent = Math.max(0,fr.u).toFixed(1) + ' m/s';
}

/* ---------------- table ---------------- */
function rowsForData(){
  const r=run, out=[];
  if (!r.crashed) return out;
  const t0 = Math.max(0, r.contactT - .01), t1 = Math.min(r.slowEnd,r.ejection?.t??Infinity);
  for (let t=t0; t<=t1+1e-9; t+=.005){ out.push(frameAt(t)); }
  return out;
}
function buildTable(){
  const area = $('tableArea');
  if (!run || !played){ area.innerHTML = '<p class="empty">Press <strong>Play</strong> to run a crash. The data will show up here.</p>'; return; }
  if (!run.crashed){ area.innerHTML = '<p class="empty">No crash happened, so there is no crash data. Nice braking!</p>'; return; }
  const rows = rowsForData();
  const fmt = (v,d)=> (Math.abs(v)<5e-4?0:v).toFixed(d);
  let h = '<div class="tblwrap"><table><thead><tr><th>Time<small>(s)</small></th><th>Car v<small>(m/s)</small></th><th>Car a<small>(m/s²)</small></th><th>Dummy v<small>(m/s)</small></th><th>Dummy a<small>(m/s²)</small></th><th>Dummy F<small>(kN)</small></th></tr></thead><tbody>';
  let marked=false;
  for (const f of rows){
    const imp = !marked && f.t >= run.contactT; if (imp) marked = true;
    h += `<tr${imp?' class="impact"':''}><td>${f.t.toFixed(3)}</td><td>${fmt(f.u,1)}</td><td>${fmt(f.aF,0)}</td><td>${fmt(f.uD,1)}</td><td>${fmt(f.aD,0)}</td><td>${fmt(f.Fd,2)}</td></tr>`;
  }
  area.innerHTML = h + '</tbody></table></div>';
}
$('copyBtn').addEventListener('click', () => {
  if (!run || !played || !run.crashed){ $('copyMsg').textContent='Run a crash first.'; return; }
  const lines = ['Time (s)\tCar v (m/s)\tCar a (m/s²)\tDummy v (m/s)\tDummy a (m/s²)\tDummy F (kN)'];
  for (const f of rowsForData()) lines.push([f.t.toFixed(3),f.u.toFixed(2),f.aF.toFixed(1),f.uD.toFixed(2),f.aD.toFixed(1),f.Fd.toFixed(3)].join('\t'));
  const text = lines.join('\n');
  const fb = () => { const ta=$('copyFallback'); ta.hidden=false; ta.value=text; ta.focus(); ta.select(); $('copyMsg').textContent='Press Ctrl+C to copy the selected data.'; };
  try { navigator.clipboard.writeText(text).then(()=>{ $('copyMsg').textContent='Copied. Paste into a spreadsheet.'; $('copyFallback').hidden=true; }, fb); } catch(e){ fb(); }
});

/* ---------------- results ---------------- */
function survColor(p){ return p>=80 ? 'var(--good)' : p>=40 ? 'var(--warn)' : 'var(--bad)'; }
function outcomeText(p){ return p>=90 ? 'Minor injuries likely' : p>=60 ? 'Serious injuries possible' : p>=25 ? 'Serious injuries likely' : 'Life-threatening injuries'; }
function buildSummary(){
  const el = $('summaryView');
  let h = '';
  if (!run || !played){ h += '<p class="empty">Press <strong>Play</strong> to run a crash. Results will show up here.</p>'; }
  else if (!run.crashed){ h += '<div class="verdict"><div class="meter" style="color:var(--good)">100%</div><div><div class="lbl">Likelihood of survival</div>No crash. The collision avoidance system stopped the car in time.</div></div>'; }
  else {
    const r = run, g = x => (x/9.81).toFixed(0);
    const ev = [];
    if (r.czPct >= 99.5) ev.push('The crumple zone was fully crushed.');
    if (r.cellDef > .005) ev.push(`The safety cell was crushed by ${r.cellPct.toFixed(0)}%.`); else ev.push('The safety cell stayed in one piece.');
    if(r.ejection)ev.push('The unbelted dummy broke through the windshield. The 60 mph ejection animation rule was met. Cabin force data ends at ejection.');
    if (r.hitBag&&!r.ejection) ev.push('The dummy was caught by the airbag.');
    else if (r.cfg.bag && !r.bagFire) ev.push('The crash was too gentle for the airbag to fire.');
    if (r.headStrike) ev.push("The dummy's head swung forward and hit the steering wheel.");
    if (r.hitWheel) ev.push(`The dummy hit the steering wheel at ${r.wheelSpeed.toFixed(1)} m/s.`);
    else if (r.cfg.belt && !r.headStrike) ev.push('The seat belt kept the dummy off the steering wheel.');
    if (r.two && r.car2Def > 0) ev.push(`Car 2 crushed ${(r.car2Def*100).toFixed(0)} cm.`);
    h += `${r.ejection?'<div class="verdict"><div class="meter" style="color:var(--bad)">↗</div><div><div class="lbl">Dummy ejected</div>Unbelted · impact at or above 60 mph. Illustrated flight; no survival estimate.</div></div>':`<div class="verdict"><div class="meter" style="color:${survColor(r.surv)}">${r.surv}%</div><div><div class="lbl">Likelihood of survival</div>${outcomeText(r.surv)}</div></div>`}
    <dl class="kv" style="margin:10px 0 0">
      <dt>Impact speed (car 1)</dt><dd>${r.impactSpeed.toFixed(1)} m/s (${(r.impactSpeed*2.237).toFixed(0)} mph)</dd>
      <dt>Total vehicle shortening</dt><dd>${(r.czDef+r.cellDef).toFixed(2)} m (${((r.czDef+r.cellDef)/r.st.L*100).toFixed(0)}% of car length)</dd>
      <dt>Crumple zone deformation</dt><dd>${r.czDef.toFixed(2)} m (${r.czPct.toFixed(0)}%)</dd>
      <dt>Safety cell deformation</dt><dd>${r.cellDef.toFixed(2)} m (${r.cellPct.toFixed(0)}%)</dd>
      <dt>Dummy forward movement</dt><dd>${Math.max(0,r.maxS).toFixed(2)} m</dd>
      <dt>Max car deceleration</dt><dd>${r.maxCarDec.toFixed(0)} m/s² (${g(r.maxCarDec)} g)</dd>
      <dt>Max dummy deceleration</dt><dd>${r.maxDumDec.toFixed(0)} m/s² (${g(r.maxDumDec)} g)</dd>
      <dt>Max force on dummy</dt><dd>${r.maxFd.toFixed(1)} kN</dd>
      <dt>Lowest possible max force</dt><dd>${r.Fmin.toFixed(1)} kN</dd>
    </dl>
    <ul class="events" style="margin-top:8px">${ev.map(e=>`<li>${e}</li>`).join('')}</ul>`;
  }
  if (trials.length){
    h += `<div style="margin-top:14px"><div class="eyebrow" style="margin-bottom:6px">Trial log</div><div class="tblwrap"><table class="trials"><thead><tr>
      <th>#</th><th>Car</th><th>Crash</th><th>Speed<small>m/s</small></th><th>CZ<small>cm / kN</small></th><th>Belt</th><th>Bag</th><th>Dummy<small>max g</small></th><th>Survival</th></tr></thead><tbody>`;
    trials.slice().reverse().forEach(t => {
      h += `<tr><td>${t.n}</td><td style="text-align:left">${t.car}</td><td style="text-align:left">${t.mode}</td><td>${t.v}</td><td>${t.cz}</td><td>${t.belt}</td><td>${t.bag}</td><td>${t.g}</td><td style="color:${survColor(t.s)}">${t.s===null?'Ejected':t.s+'%'}</td></tr>`;
    });
    h += '</tbody></table></div></div>';
  }
  el.innerHTML = h;
}
function logTrial(){
  const r=run, c=r.cfg;
  trials.push({ n: trials.length+1, car: r.st.name, mode: c.mode==='two' ? `2 cars (${c.v2} m/s)` : 'Wall', v: c.v1 + (c.cas?' + CAS':''),
    cz: `${c.czLen} / ${c.czRig}`, belt: c.belt ? c.beltK : '—', bag: c.bag ? c.bagR : '—', g: r.crashed ? (r.maxDumDec/9.81).toFixed(0) : '0', s: r.surv });
  if (trials.length > 30) trials.shift();
}

/* graph */
const gcv = $('graph'), gctx = gcv.getContext('2d');
function drawGraph(){
  if (tab!=='results' || resultsView!=='graph') return;
  const { w:W, h:H, dpr } = fitCanvas(gcv), ctx = gctx;
  ctx.clearRect(0,0,W,H);
  const lg = $('legend');
  if (!run || !played || !run.crashed){ ctx.fillStyle=C.muted; ctx.font=`600 ${14*dpr}px Poppins, system-ui, sans-serif`; ctx.textAlign='center'; ctx.fillText(run && played ? 'No crash to graph.' : 'Run a crash to see the graph.', W/2, H/2); ctx.textAlign='left'; lg.innerHTML=''; return; }
  const r = run, sel = $('yaxis').value;
  const t0 = r.contactT - .01, t1 = Math.min(r.slowEnd,r.ejection?.t??Infinity);
  const fr = r.frames.filter(f => f.t >= t0 && f.t <= t1);
  const f0 = frameAt(r.contactT);
  const series = [];
  if (sel==='disp'){ series.push({name:'Car', col:r.st.paint.base, v:fr.map(f=> -(f.p1 - f0.p1))}); series.push({name:'Dummy', col:C.series2, v:fr.map(f=> -(f.p1 - f0.p1) + (f.sd - f0.sd))}); }
  if (sel==='vel'){ series.push({name:'Car', col:r.st.paint.base, v:fr.map(f=>f.u)}); series.push({name:'Dummy', col:C.series2, v:fr.map(f=>f.uD)}); }
  if (sel==='dec'){ series.push({name:'Car', col:r.st.paint.base, v:fr.map(f=>-f.aF)}); series.push({name:'Dummy', col:C.series2, v:fr.map(f=>-f.aD)}); }
  if (sel==='fd'){ series.push({name:'Dummy', col:C.series2, v:fr.map(f=>f.Fd)}); }
  if (sel==='fc'){ series.push({name:'Car', col:r.st.paint.base, v:fr.map(f=>f.F)}); }
  lg.innerHTML = series.map(s=>`<span><span class="sw" style="background:${s.col}"></span>${s.name}</span>`).join('');
  let ymin = Math.min(0, ...series.flatMap(s=>s.v)), ymax = Math.max(...series.flatMap(s=>s.v));
  if (ymax - ymin < 1e-6) ymax = ymin + 1;
  const nice = (span) => { const raw=span/5, p=Math.pow(10,Math.floor(Math.log10(raw))), m=raw/p; return (m<1.5?1:m<3?2:m<7?5:10)*p; };
  const step = nice(ymax-ymin); ymin = Math.floor(ymin/step)*step; ymax = Math.ceil(ymax/step)*step;
  const tstep = nice((t1-t0)*1.0);
  const L = 58*dpr, R = 12*dpr, Tm = 14*dpr, B = 36*dpr;
  const X = t => L + (t - t0)/(t1 - t0)*(W-L-R), Y = v => Tm + (ymax - v)/(ymax - ymin)*(H-Tm-B);
  ctx.font = `600 ${11.5*dpr}px Poppins, system-ui, sans-serif`; ctx.lineWidth = Math.max(1,dpr);
  ctx.fillStyle = C.muted; ctx.textBaseline='middle'; ctx.textAlign='right';
  for (let v=ymin; v<=ymax+1e-9; v+=step){ ctx.strokeStyle=C.line; ctx.beginPath(); ctx.moveTo(L,Y(v)); ctx.lineTo(W-R,Y(v)); ctx.stroke(); ctx.fillText(+v.toPrecision(6)+'', L-6*dpr, Y(v)); }
  ctx.textAlign='center'; ctx.textBaseline='top';
  for (let t=Math.ceil(t0/tstep)*tstep; t<=t1+1e-9; t+=tstep){ ctx.strokeStyle=C.line; ctx.beginPath(); ctx.moveTo(X(t),Tm); ctx.lineTo(X(t),H-B); ctx.stroke(); ctx.fillText(t.toFixed(tstep<.01?3:2), X(t), H-B+5*dpr); }
  ctx.fillStyle=C.ink; ctx.font=`700 ${12*dpr}px Poppins, system-ui, sans-serif`; ctx.fillText('Time (s)', (L+W-R)/2, H-B+19*dpr);
  // impact marker
  ctx.strokeStyle=C.bad; ctx.setLineDash([4*dpr,4*dpr]); ctx.beginPath(); ctx.moveTo(X(r.contactT),Tm); ctx.lineTo(X(r.contactT),H-B); ctx.stroke(); ctx.setLineDash([]);
  ctx.fillStyle=C.bad; ctx.textAlign='left'; ctx.fillText('impact', X(r.contactT)+4*dpr, Tm+2*dpr);
  for (const s of series){
    ctx.strokeStyle = s.col; ctx.lineWidth = 2.5*dpr; ctx.lineJoin='round'; ctx.beginPath();
    s.v.forEach((v,i)=>{ const x=X(fr[i].t), y=Y(v); i?ctx.lineTo(x,y):ctx.moveTo(x,y); }); ctx.stroke();
  }
  ctx.textAlign='left';
}
$('yaxis').addEventListener('change', drawGraph);

/* ---------------- UI wiring ---------------- */
const sliders = ['czLen','czRig','cellRig','beltK','bagR','v1','v2','m2'];
document.querySelectorAll('[data-speed]').forEach(button=>button.addEventListener('click',()=>{
  const speed=+button.dataset.speed;cfg.v1=speed;$('v1').value=speed;$('v1_n').value=speed;changed();
}));
sliders.forEach(id => {
  const r = $(id), n = $(id+'_n');
  r.addEventListener('input', () => { n.value = r.value; cfg[id] = +r.value; changed(); });
  n.addEventListener('change', () => { let v = Math.min(+n.max, Math.max(+n.min, +n.value || 0)); n.value=v; r.value=v; cfg[id]=v; changed(); });
});
$('style').addEventListener('change', e => { cfg.style = e.target.value; changed(); });
['belt','bag','cas'].forEach(id => $(id).addEventListener('change', e => { cfg[id] = e.target.checked; changed(); }));
function setMode(m){ cfg.mode = m; $('modeOne').setAttribute('aria-pressed', m==='one'); $('modeTwo').setAttribute('aria-pressed', m==='two'); $('car2Rows').hidden = m!=='two'; changed(); }
$('modeOne').addEventListener('click', ()=>setMode('one')); $('modeTwo').addEventListener('click', ()=>setMode('two'));
function setView(v){ resultsView=v; $('vSummary').setAttribute('aria-pressed', v==='summary'); $('vGraph').setAttribute('aria-pressed', v==='graph'); $('summaryView').hidden = v!=='summary'; $('graphView').hidden = v!=='graph'; drawGraph(); }
$('vSummary').addEventListener('click', ()=>setView('summary')); $('vGraph').addEventListener('click', ()=>setView('graph'));

const TABS = ['design','test','table','results'];
function setTab(t){
  tab = t;
  TABS.forEach(k => { $('t-'+k).setAttribute('aria-selected', k===t); $('p-'+k).hidden = k!==t; });
  try { localStorage.setItem('crumple-tab', t); } catch(e){}
  if (t==='table') buildTable();
  if (t==='results'){ buildSummary(); drawGraph(); }
  drawAll();
}
TABS.forEach(k => $('t-'+k).addEventListener('click', () => setTab(k)));
document.querySelector('.tabs').addEventListener('keydown', e => {
  const i = TABS.indexOf(tab);
  if (e.key==='ArrowRight'||e.key==='ArrowLeft'){ const j=(i + (e.key==='ArrowRight'?1:3))%4; setTab(TABS[j]); $('t-'+TABS[j]).focus(); e.preventDefault(); }
});

function describe(){
  const st = STYLES[cfg.style];
  const mph = v => (v*2.237).toFixed(0);
  let d = `<strong>Car 1</strong> is a ${st.name.toLowerCase()} with a mass of ${st.mass.toLocaleString()} kg. Its crumple zone is ${cfg.czLen} cm long and crushes at ${cfg.czRig.toLocaleString()} kN. `;
  d += cfg.belt ? `It has a seat belt (${cfg.beltK} kN/m)` : 'It has no seat belt';
  d += cfg.bag ? ` and an airbag (${cfg.bagR} kN).` : ' and no airbag.';
  d += ` Its speed is ${cfg.v1} m/s (${mph(cfg.v1)} mph).`;
  if (cfg.mode==='two') d += `<br><strong>Car 2</strong> has a mass of ${cfg.m2.toLocaleString()} kg and a speed of ${cfg.v2} m/s (${mph(cfg.v2)} mph).`;
  else d += ' It will hit a solid concrete wall.';
  d += '<br>Press <strong>Play</strong> to run the crash test.';
  $('testDesc').innerHTML = d;
  $('designChips').innerHTML = `<span class="chip">Mass ${st.mass.toLocaleString()} kg</span><span class="chip">Car length ${st.L} m</span><span class="chip">Steering wheel gap ${S_WHEEL} m</span>`;
  $('beltRow').hidden = !cfg.belt; $('bagRow').hidden = !cfg.bag;
}

let pending = 0;
function changed(){
  describe();
  pause();
  cancelAnimationFrame(pending);
  pending = requestAnimationFrame(() => { run = simulate(cfg); T = 0; played = false; refreshPanels(); drawAll(); });
}
function refreshPanels(){ if (tab==='table') buildTable(); if (tab==='results'){ buildSummary(); drawGraph(); } }

/* ---------------- playback ---------------- */
function setControlsDisabled(d){ $('fsDesign').disabled = d; $('fsTest').disabled = d; }
function play(){
  if (!run) return;
  if (T >= run.tEnd - 1e-9) { T = 0; }
  playing = true; lastTs = 0; setControlsDisabled(true);
  $('playBtn').disabled = true; $('pauseBtn').disabled = false;
  requestAnimationFrame(tick);
}
function pause(){
  playing = false; setControlsDisabled(false);
  $('playBtn').disabled = false; $('pauseBtn').disabled = true;
  $('playBtn').querySelector('span').textContent = (run && T >= run.tEnd - 1e-9) ? 'Replay' : (T>0 ? 'Resume' : 'Play');
}
function reset(){ pause(); T = 0; $('playBtn').querySelector('span').textContent='Play'; drawAll(); }
function finish(){
  T = run.tEnd; const first = !played; played = true; if (first) logTrial(); pause(); refreshPanels(); drawAll();
}
function tick(ts){
  if (!playing) return;
  const real = lastTs ? Math.min(.05, (ts - lastTs)/1000) : 0; lastTs = ts;
  const rate = playbackRate(run,T);
  T += real*rate;
  if (T >= run.tEnd){ finish(); return; }
  drawAll();
  requestAnimationFrame(tick);
}
$('playBtn').addEventListener('click', play);
$('pauseBtn').addEventListener('click', pause);
$('resetBtn').addEventListener('click', reset);

function drawAll(){ drawScene(); drawOverview(); updateReadouts(); }
const ro = new ResizeObserver(() => { drawAll(); drawGraph(); });
ro.observe(scene); ro.observe(ov); ro.observe(gcv);
if (document.fonts && document.fonts.ready) document.fonts.ready.then(drawAll);

// init
describe();
run = simulate(cfg);
let saved = null; try { saved = localStorage.getItem('crumple-tab'); } catch(e){}
setTab(TABS.includes(saved) ? saved : 'design');
setView('summary');
})();
</script>

