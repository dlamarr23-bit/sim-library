/* ---------------- canvas helpers ---------------- */
function fitCanvas(cv){
  const r = cv.getBoundingClientRect(), dpr = Math.min(2, window.devicePixelRatio||1);
  const w = Math.max(1, Math.round(r.width*dpr)), h = Math.max(1, Math.round(r.height*dpr));
  if (cv.width!==w || cv.height!==h){ cv.width=w; cv.height=h; }
  return { w, h, dpr };
}

/* ---------------- scene ---------------- */
const scene = $('scene'), sctx = scene.getContext('2d');
function drawScene(){
  if (!run) return;
  const { w:W, h:H, dpr } = fitCanvas(scene);
  const ctx = sctx, fr = frameAt(T), r = run, st = r.st;
  // Frame both vehicles in head-on mode, including the opposing car's rear.
  // A fixed single-car scale preserves the size difference between body styles.
  const ej=ejectionPose(r,fr.t),age=r.crashed?fr.t-r.contactT:-1;
  const zoom=ej?Math.min(1,ej.age/.18):0,blend=zoom*zoom*(3-2*zoom);
  const baseSpan=r.two?fr.p1+st.L-(fr.p2-STYLES.sedan.L)+1.2:STYLES.suv.L+2.05;
  const flightLeft=ej?Math.min(-1.7,ej.x-1.1,r.two?fr.p2-STYLES.sedan.L:0):0;
  const flightRight=ej?Math.max(fr.p1+st.L+.5,ej.x+1.1):0;
  const span=ej?baseSpan+(Math.max(baseSpan,flightRight-flightLeft+1)-baseSpan)*blend:baseSpan;
  const shake=age>=0&&age<.18?Math.min(1,r.impactClosing/45)*1.8*dpr*(1-Math.exp(-age*90))*Math.exp(-age*18):0;
  const shakeX=Math.sin(age*121)*shake;
  const ppm = Math.min(H/((r.two?3.9:3.4)+blend*1.5), W/span), groundY = H*.78+Math.sin(age*97)*shake*.5;
  const anchorScreen = Math.min(W*.22, ppm + 10*dpr);
  const front1 = fr.p1 + fr.c1;
  let anchor;
  if (r.crashed && T >= r.contactT) anchor = front1;
  else anchor = r.impactX!=null ? Math.max(front1 - .5, r.impactX) : front1 - .5;
  if (!r.crashed && !r.two) anchor = Math.max(front1 - .5, 0);
  const center = r.two ? (fr.p1+st.L+fr.p2-STYLES.sedan.L)/2 : 0;
  const normalCenter=r.two?center:anchor+(W/2-anchorScreen)/ppm;
  const cameraCenter=ej?normalCenter+((flightLeft+flightRight)/2-normalCenter)*blend:normalCenter;
  const X = wx => W/2+(wx-cameraCenter)*ppm+shakeX;
  const Y = h => groundY - h*ppm;

  // lab wall with measurement grid
  ctx.fillStyle = C.labwall; ctx.fillRect(0,0,W,H);
  ctx.strokeStyle = C.grid; ctx.lineWidth = Math.max(1,dpr);
  const leftW = cameraCenter-W/(2*ppm), rightW = leftW + W/ppm;
  for (let gx = Math.floor(leftW/.5)*.5; gx <= rightW; gx += .5){ const sx=X(gx); ctx.beginPath(); ctx.moveTo(sx,0); ctx.lineTo(sx,groundY); ctx.stroke(); }
  for (let gy=.5; gy*ppm < groundY; gy+=.5){ ctx.beginPath(); ctx.moveTo(0,Y(gy)); ctx.lineTo(W,Y(gy)); ctx.stroke(); }
  ctx.fillStyle = C.muted; ctx.font = `700 ${11*dpr}px Poppins, system-ui, sans-serif`; ctx.textBaseline='top';
  for (let gx = Math.ceil(leftW); gx <= rightW; gx += 1){ ctx.fillText(gx.toFixed(0)+' m', X(gx)+3*dpr, 4*dpr); }
  // The tire contact plane runs through the lane, below the road's far edge.
  const roadTop=groundY-Math.max(.65*ppm,20*dpr);
  const dividerY=groundY+Math.max(.55*ppm,18*dpr);
  ctx.fillStyle = C.asphalt; ctx.fillRect(0,roadTop,W,H-roadTop);
  ctx.fillStyle = C['asphalt-line'];
  ctx.save();ctx.globalAlpha=.5;ctx.fillRect(0,roadTop+4*dpr,W,Math.max(1,ppm*.018));ctx.restore();
  for (let gx = Math.floor(leftW/2)*2; gx <= rightW; gx += 2){ ctx.fillRect(X(gx),dividerY,ppm,Math.max(2,ppm*.045)); }

