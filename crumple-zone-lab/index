<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Crumple Zone Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<style>
/* Layout: split-screen first. Stacked app shell fills one screen (scene → overview → transport → tabbed panel that scrolls inside).
   At ≥1000px wide it becomes two columns: scene left, controls right. Guides sit below the shell. */
:root{
  --bg:#EEF1F4; --surface:#FFFFFF; --surface-2:#E4E9EF; --ink:#141A22; --muted:#5A6573; --line:#CED6E0;
  --accent:#F2B705; --accent-ink:#141A22; --car1:#87B7E8; --car2:#D23A30; --dummy:#E5A91C; --series2:#E06A12;
  --good:#1D9A55; --warn:#C98200; --bad:#CF3328;
  --sky:#DCE3EB; --labwall:#E8ECF1; --grid:#C9D2DD; --asphalt:#5A6069; --asphalt-line:#E7EAEE; --concrete:#B8BDC4; --glass:#9FB6CF; --interior:#3A414B;
  --font: "Poppins", system-ui, -apple-system, "Segoe UI", sans-serif;
  --r:12px;
}
@media (prefers-color-scheme: dark){ :root:not([data-theme="light"]){
  --bg:#0F1318; --surface:#171C23; --surface-2:#222A35; --ink:#EDF1F6; --muted:#9AA6B5; --line:#2D3643;
  --accent:#F5C02A; --accent-ink:#141A22; --car1:#87B7E8; --car2:#EE5A50; --dummy:#F0B930; --series2:#F59342;
  --good:#3CC57A; --warn:#E7A632; --bad:#F0605A;
  --sky:#18202A; --labwall:#1B222B; --grid:#2A3440; --asphalt:#2B3037; --asphalt-line:#6B737D; --concrete:#5A616B; --glass:#3B5068; --interior:#0E1217;
  color-scheme:dark; } }
:root[data-theme="dark"]{
  --bg:#0F1318; --surface:#171C23; --surface-2:#222A35; --ink:#EDF1F6; --muted:#9AA6B5; --line:#2D3643;
  --accent:#F5C02A; --accent-ink:#141A22; --car1:#87B7E8; --car2:#EE5A50; --dummy:#F0B930; --series2:#F59342;
  --good:#3CC57A; --warn:#E7A632; --bad:#F0605A;
  --sky:#18202A; --labwall:#1B222B; --grid:#2A3440; --asphalt:#2B3037; --asphalt-line:#6B737D; --concrete:#5A616B; --glass:#3B5068; --interior:#0E1217;
  color-scheme:dark; }

*{box-sizing:border-box}
[hidden]{display:none!important}
html,body{height:100%}
body{margin:0;background:var(--bg);color:var(--ink);font-family:var(--font);font-weight:700;font-size:15px;line-height:1.45;
  padding-left:max(10px, env(safe-area-inset-left,0px));padding-right:max(10px, env(safe-area-inset-right,0px))}
@media (min-width:700px){ body{padding-left:max(16px, env(safe-area-inset-left,0px));padding-right:max(16px, env(safe-area-inset-right,0px))} }
button,input,select{font:inherit;color:inherit}
:focus-visible{outline:3px solid var(--accent);outline-offset:2px}

.page{max-width:min(1900px,97vw);margin:0 auto}
.app{height:100vh;height:100dvh;min-height:520px;display:grid;gap:8px;padding-block:8px;
  grid-template-columns:minmax(0,1fr);grid-template-rows:auto auto minmax(0,1fr);
  grid-template-areas:"bar" "stage" "panel"}
@media (min-width:1000px){
  .app{grid-template-columns:minmax(0,1.4fr) minmax(360px,1fr);grid-template-rows:auto minmax(0,1fr);
    grid-template-areas:"bar bar" "stage panel";gap:12px;padding-block:12px}
}

/* header */
.bar{grid-area:bar;display:flex;align-items:center;gap:10px;min-width:0}
.mark{width:30px;height:30px;border-radius:8px;flex:none;
  background:repeating-linear-gradient(135deg,var(--accent) 0 6px,var(--accent-ink) 6px 12px)}
.titles{min-width:0;flex:1}
.eyebrow{font-size:11px;letter-spacing:.14em;text-transform:uppercase;color:var(--muted);font-weight:800;line-height:1.1}
h1{margin:0;font-size:clamp(19px,2.4vw,30px);font-weight:800;line-height:1.1;text-wrap:balance;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.iconbtn{width:40px;height:40px;border-radius:50%;border:2px solid var(--line);background:var(--surface);display:grid;place-items:center;cursor:pointer;flex:none}
.iconbtn:hover{border-color:var(--muted)}
.iconbtn svg{width:20px;height:20px;fill:none;stroke:var(--ink);stroke-width:2.2;stroke-linecap:round;stroke-linejoin:round}

/* stage */
.stage{grid-area:stage;display:flex;flex-direction:column;gap:6px;min-width:0;min-height:0}
.scene-wrap{position:relative;border-radius:var(--r);overflow:hidden;border:2px solid var(--line);background:var(--sky);
  height:clamp(160px,33dvh,440px)}
@media (min-width:1000px){ .scene-wrap{height:auto;flex:1;min-height:260px} }
#scene{display:block;width:100%;height:100%}
.tag{position:absolute;left:10px;bottom:10px;padding:4px 10px;border-radius:6px;font-size:13px;font-weight:800;letter-spacing:.06em;text-transform:uppercase;
  background:var(--accent);color:var(--accent-ink)}
.overview-wrap{border-radius:10px;overflow:hidden;border:2px solid var(--line);height:42px;flex:none}
#overview{display:block;width:100%;height:100%}
.transport{display:flex;align-items:center;gap:8px;flex-wrap:wrap;flex:none}
.tbtn{height:42px;min-width:46px;padding:0 12px;border-radius:10px;border:2px solid var(--line);background:var(--surface);cursor:pointer;
  display:inline-flex;align-items:center;justify-content:center;gap:6px;font-weight:800;font-size:14px;letter-spacing:.06em;text-transform:uppercase}
.tbtn svg{width:18px;height:18px;fill:currentColor}
.tbtn.play{background:var(--accent);border-color:var(--accent);color:var(--accent-ink);min-width:96px}
.tbtn:disabled{opacity:.45;cursor:not-allowed}
.readouts{display:flex;gap:14px;margin-left:auto;font-variant-numeric:tabular-nums}
.ro{display:flex;flex-direction:column;line-height:1.1}
.ro small{font-size:10.5px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted);font-weight:800}
.ro b{font-size:clamp(17px,2vw,24px);font-weight:800}

/* panel */
.panel{grid-area:panel;min-height:0;display:flex;flex-direction:column;background:var(--surface);border:2px solid var(--line);border-radius:var(--r);overflow:hidden}
.tabs{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:2px solid var(--line);flex:none;background:var(--surface-2)}
.tab{border:0;background:transparent;padding:10px 4px 8px;font-size:12.5px;font-weight:800;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);cursor:pointer;
  border-bottom:4px solid transparent;margin-bottom:-2px}
.tab[aria-selected="true"]{color:var(--ink);border-bottom-color:var(--accent);background:var(--surface)}
.tabbody{flex:1;min-height:0;overflow:auto;padding:12px 14px 16px}
fieldset{border:0;margin:0;padding:0;min-width:0;display:grid;gap:10px}
fieldset:disabled{opacity:.6}

.row{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1.3fr) 76px;align-items:center;gap:10px}
.row label,.row .lbl{font-size:14.5px;font-weight:700;line-height:1.2}
.row .unit{color:var(--muted);font-weight:600;font-size:12.5px}
.row.sub{padding-left:22px}
@media (max-width:480px){ .row{grid-template-columns:minmax(0,1fr) 76px} .row label,.row .lbl{grid-column:1/-1} .row.sub{padding-left:10px} }
.num{width:76px;height:38px;border-radius:8px;border:2px solid var(--line);background:var(--surface-2);text-align:center;font-weight:800;font-size:15px;font-variant-numeric:tabular-nums}
select{height:40px;border-radius:8px;border:2px solid var(--line);background:var(--surface-2);padding:0 10px;font-weight:700;font-size:15px;min-width:0;width:100%}
input[type=range]{-webkit-appearance:none;appearance:none;width:100%;height:28px;background:transparent;margin:0;cursor:pointer}
input[type=range]::-webkit-slider-runnable-track{height:6px;border-radius:3px;background:var(--line)}
input[type=range]::-moz-range-track{height:6px;border-radius:3px;background:var(--line)}
input[type=range]::-webkit-slider-thumb{-webkit-appearance:none;width:22px;height:22px;border-radius:50%;background:var(--ink);border:3px solid var(--surface);margin-top:-8px;box-shadow:0 0 0 2px var(--ink)}
input[type=range]::-moz-range-thumb{width:18px;height:18px;border-radius:50%;background:var(--ink);border:3px solid var(--surface)}
.check{display:flex;align-items:center;gap:10px;font-size:15px;cursor:pointer;min-height:38px}
.check input{width:22px;height:22px;accent-color:var(--car1);flex:none}
.seg{display:inline-flex;border:2px solid var(--line);border-radius:10px;overflow:hidden;width:100%}
.seg button{flex:1;border:0;background:var(--surface);padding:8px 6px;font-weight:800;font-size:13.5px;cursor:pointer;min-height:40px}
.seg button[aria-pressed="true"]{background:var(--ink);color:var(--surface)}
.chips{display:flex;gap:8px;flex-wrap:wrap}
.chip{font-size:12.5px;padding:3px 10px;border-radius:999px;background:var(--surface-2);border:1.5px solid var(--line);font-variant-numeric:tabular-nums}
.desc{font-weight:500;font-size:14.5px;color:var(--ink);margin:0;max-width:62ch}
.desc strong{font-weight:800}
.hr{height:2px;background:var(--line);border:0;margin:2px 0}

/* table */
.tblwrap{overflow:auto;border:2px solid var(--line);border-radius:10px;max-height:100%}
table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums;font-size:13.5px}
th,td{padding:6px 8px;text-align:right;white-space:nowrap}
th{position:sticky;top:0;background:var(--surface-2);font-weight:800;font-size:12px;line-height:1.2;text-align:right;vertical-align:bottom}
th small{display:block;color:var(--muted);font-weight:700}
tbody tr:nth-child(even){background:color-mix(in srgb,var(--surface-2) 45%,transparent)}
tr.impact td{color:var(--bad)}
.tools{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.btn{height:40px;padding:0 14px;border-radius:10px;border:2px solid var(--line);background:var(--surface-2);font-weight:800;cursor:pointer;font-size:14px}
.btn:hover{border-color:var(--muted)}
.empty{color:var(--muted);font-weight:600;padding:18px 4px;text-align:center}
.toast{font-size:13px;color:var(--good)}

/* results */
.kv{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:2px 12px;font-variant-numeric:tabular-nums}
.kv dt{font-weight:600;color:var(--muted);font-size:14px}
.kv dd{margin:0;font-weight:800;text-align:right;font-size:14.5px}
.verdict{display:flex;gap:12px;align-items:center;padding:10px 12px;border-radius:10px;background:var(--surface-2)}
.meter{font-size:30px;font-weight:800;line-height:1;font-variant-numeric:tabular-nums}
.verdict .lbl{font-size:11px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.events{margin:0;padding-left:20px;font-weight:600;font-size:14px}
.trials{font-size:12.5px}
.trials td,.trials th{padding:5px 6px}
.graphbox{position:relative;height:clamp(200px,40dvh,420px)}
#graph{width:100%;height:100%;display:block}
.legend{display:flex;gap:14px;font-size:13px;align-items:center}
.sw{display:inline-block;width:18px;height:4px;border-radius:2px;vertical-align:middle;margin-right:6px}

/* guides */
.guides{display:grid;gap:12px;padding-block:6px 28px}
@media (min-width:1000px){ .guides{grid-template-columns:1fr 1fr;align-items:start} }
details{background:var(--surface);border:2px solid var(--line);border-radius:var(--r)}
summary{list-style:none;cursor:pointer;padding:14px 16px;display:flex;align-items:center;gap:10px;font-weight:800;font-size:15px;letter-spacing:.1em;text-transform:uppercase}
summary::-webkit-details-marker{display:none}
summary .chev{margin-left:auto;width:12px;height:12px;border-right:3px solid var(--ink);border-bottom:3px solid var(--ink);transform:rotate(45deg);transition:transform .2s}
details[open] summary .chev{transform:rotate(-135deg)}
.dbody{padding:0 18px 16px;font-weight:500;font-size:15.5px;max-width:70ch}
.dbody ol{padding-left:22px;margin:0;display:grid;gap:8px}
.dbody p{margin:0 0 10px}
.dbody strong{font-weight:800}
.eq{display:inline-block;padding:2px 10px;border-radius:6px;background:var(--surface-2);font-weight:800;font-variant-numeric:tabular-nums}
@media (prefers-reduced-motion:reduce){ summary .chev{transition:none} }
</style>
<script>
  // apply a light/dark choice before the page paints: the textbook names a mode with ?theme=light or dark, otherwise the device's setting decides
  (function(){
    var t = null;
    try{ t = new URLSearchParams(location.search).get('theme'); }catch(e){}
    if(t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
  })();
</script>
</head>
<body>

<div class="page">
<main class="app">
  <header class="bar">
    <div class="mark" aria-hidden="true"></div>
    <div class="titles">
      <div class="eyebrow">Motion Lab</div>
      <h1>Crumple Zone Lab</h1>
    </div>
    <button class="iconbtn" id="helpBtn" title="How to use this simulation" aria-label="How to use this simulation">
      <svg viewBox="0 0 24 24"><circle cx="12" cy="12" r="9.5"/><path d="M9.3 9.2a2.8 2.8 0 1 1 3.9 2.6c-.8.4-1.2 1-1.2 1.8v.6"/><circle cx="12" cy="17.3" r=".6" fill="currentColor"/></svg>
    </button>
  </header>

  <section class="stage" aria-label="Simulation">
    <div class="scene-wrap">
      <canvas id="scene" aria-label="Side view of the crash"></canvas>
      <span class="tag" id="slowTag" hidden>Slow-mo replay</span>
    </div>
    <div class="overview-wrap"><canvas id="overview" aria-label="Overview of the test track"></canvas></div>
    <div class="transport">
      <button class="tbtn play" id="playBtn"><svg viewBox="0 0 24 24"><path d="M7 4.5v15l13-7.5z"/></svg><span>Play</span></button>
      <button class="tbtn" id="pauseBtn" aria-label="Pause" disabled><svg viewBox="0 0 24 24"><path d="M6 4h4.5v16H6zM13.5 4H18v16h-4.5z"/></svg></button>
      <button class="tbtn" id="resetBtn" aria-label="Reset"><svg viewBox="0 0 24 24"><path d="M12 5a7 7 0 1 1-6.6 4.7l2 .7A4.9 4.9 0 1 0 12 7.1V10L7.5 6 12 2z"/></svg></button>
      <div class="readouts">
        <div class="ro"><small>Time</small><b id="roTime">0.000 s</b></div>
        <div class="ro"><small>Car 1 speed</small><b id="roSpeed">16.0 m/s</b></div>
      </div>
    </div>
  </section>

  <section class="panel" aria-label="Controls">
    <div class="tabs" role="tablist">
      <button class="tab" role="tab" id="t-design" aria-controls="p-design" aria-selected="true">Design</button>
      <button class="tab" role="tab" id="t-test" aria-controls="p-test" aria-selected="false">Crash test</button>
      <button class="tab" role="tab" id="t-table" aria-controls="p-table" aria-selected="false">Table</button>
      <button class="tab" role="tab" id="t-results" aria-controls="p-results" aria-selected="false">Results</button>
    </div>

    <div class="tabbody" role="tabpanel" id="p-design" aria-labelledby="t-design">
      <fieldset id="fsDesign">
        <div class="row"><label for="style">Body style</label>
          <select id="style" style="grid-column:2/-1">
            <option value="subcompact">Subcompact (950 kg)</option>
            <option value="sedan" selected>Compact sedan (1,450 kg)</option>
            <option value="suv">SUV (2,000 kg)</option>
          </select></div>
        <div class="row"><label for="czLen">Crumple zone length <span class="unit">(cm)</span></label>
          <input type="range" id="czLen" min="0" max="100" step="5" value="80"><input class="num" id="czLen_n" type="number" min="0" max="100" step="5" value="80"></div>
        <div class="row"><label for="czRig">Crumple zone rigidity <span class="unit">(kN)</span></label>
          <input type="range" id="czRig" min="100" max="3000" step="50" value="400"><input class="num" id="czRig_n" type="number" min="100" max="3000" step="50" value="400"></div>
        <div class="row"><label for="cellRig">Safety cell rigidity <span class="unit">(kN)</span></label>
          <input type="range" id="cellRig" min="500" max="5000" step="100" value="2000"><input class="num" id="cellRig_n" type="number" min="500" max="5000" step="100" value="2000"></div>
        <hr class="hr">
        <label class="check"><input type="checkbox" id="belt" checked> Seat belt present</label>
        <p class="desc" style="font-size:12px;color:var(--muted)">Animation rule: an unbelted dummy can break through the windshield at an impact speed of 60 mph (26.8 m/s) or above.</p>
        <div class="row sub" id="beltRow"><label for="beltK">Seat belt stiffness <span class="unit">(kN/m)</span></label>
          <input type="range" id="beltK" min="5" max="200" step="5" value="80"><input class="num" id="beltK_n" type="number" min="5" max="200" step="5" value="80"></div>
        <label class="check"><input type="checkbox" id="bag" checked> Airbag present</label>
        <div class="row sub" id="bagRow"><label for="bagR">Airbag rigidity <span class="unit">(kN)</span></label>
          <input type="range" id="bagR" min="1" max="20" step="1" value="6"><input class="num" id="bagR_n" type="number" min="1" max="20" step="1" value="6"></div>
        <div class="chips" id="designChips"></div>
      </fieldset>
    </div>

    <div class="tabbody" role="tabpanel" id="p-test" aria-labelledby="t-test" hidden>
      <fieldset id="fsTest">
        <div class="seg" role="group" aria-label="Crash type">
          <button id="modeOne" aria-pressed="true">One car → wall</button>
          <button id="modeTwo" aria-pressed="false">Two cars head-on</button>
        </div>
        <div class="row"><label for="v1">Car 1 speed <span class="unit">(m/s)</span></label>
          <input type="range" id="v1" min="0" max="45" step="0.1" value="16"><input class="num" id="v1_n" type="number" min="0" max="45" step="0.1" value="16"></div>
        <div class="tools" role="group" aria-label="Car 1 speed presets"><span class="unit">Speed presets</span><button type="button" class="btn" data-speed="13.4">30 mph</button><button type="button" class="btn" data-speed="26.8">60 mph</button><button type="button" class="btn" data-speed="40.2">90 mph</button></div>
        <div id="car2Rows" hidden style="display:grid;gap:10px">
          <div class="row"><label for="v2">Car 2 speed <span class="unit">(m/s)</span></label>
            <input type="range" id="v2" min="0" max="45" step="0.1" value="16"><input class="num" id="v2_n" type="number" min="0" max="45" step="0.1" value="16"></div>
          <div class="row"><label for="m2">Car 2 mass <span class="unit">(kg)</span></label>
            <input type="range" id="m2" min="800" max="3000" step="50" value="1450"><input class="num" id="m2_n" type="number" min="800" max="3000" step="50" value="1450"></div>
        </div>
        <label class="check"><input type="checkbox" id="cas"> Collision avoidance system (auto-brakes car 1)</label>
        <p class="desc" id="testDesc"></p>
      </fieldset>
    </div>

    <div class="tabbody" role="tabpanel" id="p-table" aria-labelledby="t-table" hidden>
      <div style="display:grid;gap:10px">
        <div class="tools">
          <button class="btn" id="copyBtn">Copy data</button>
          <span class="toast" id="copyMsg" aria-live="polite"></span>
          <span class="desc" style="font-size:13px;color:var(--muted);margin-left:auto">Data for car 1 and its dummy. Red row = moment of impact.</span>
        </div>
        <textarea id="copyFallback" hidden readonly style="width:100%;height:80px"></textarea>
        <div id="tableArea"></div>
      </div>
    </div>

    <div class="tabbody" role="tabpanel" id="p-results" aria-labelledby="t-results" hidden>
      <div style="display:grid;gap:12px">
        <div class="seg" role="group" aria-label="Results view" style="max-width:340px">
          <button id="vSummary" aria-pressed="true">Summary</button>
          <button id="vGraph" aria-pressed="false">Graph</button>
        </div>
        <div id="summaryView"></div>
        <div id="graphView" hidden style="display:grid;gap:8px">
          <div class="tools">
            <label for="yaxis" style="font-size:14px">y-axis</label>
            <select id="yaxis" style="width:auto">
              <option value="disp">Displacement (m)</option>
              <option value="vel">Velocity (m/s)</option>
              <option value="dec">Deceleration (m/s²)</option>
              <option value="fd" selected>Force on dummy (kN)</option>
              <option value="fc">Force on car (kN)</option>
            </select>
            <div class="legend" id="legend"></div>
          </div>
          <div class="graphbox"><canvas id="graph" aria-label="Results graph"></canvas></div>
        </div>
      </div>
    </div>
  </section>
</main>

<section class="guides">
  <details open id="howto">
    <summary>How to use this simulation <span class="chev" aria-hidden="true"></span></summary>
    <div class="dbody"><ol>
      <li>Open the <strong>Design</strong> tab. Pick a body style. Then set the <strong>crumple zone</strong>, the <strong>safety cell</strong>, the <strong>seat belt</strong>, and the <strong>airbag</strong>. The finished car remains visible while you adjust its design. Run a test to see how the crumple zone and restraints respond.</li>
      <li>Open the <strong>Crash test</strong> tab. Choose one car hitting a wall, or two cars hitting head-on. Set each speed. In a two-car crash you can also change car 2's mass.</li>
      <li>Press <strong>Play</strong>. The car drives up at normal speed. The crash itself plays back in <strong>slow motion</strong>, because the real crash lasts only about a tenth of a second.</li>
      <li>Watch the <strong>Time</strong> and <strong>Car 1 speed</strong> readouts. The thin strip under the scene shows the whole test track from above.</li>
      <li>Open the <strong>Results</strong> tab. The summary shows how much the car crushed, the biggest forces, and the dummy's <strong>chance of survival</strong>. Every run is added to the trial log so you can compare designs.</li>
      <li>Switch to <strong>Graph</strong> to see how displacement, velocity, deceleration, or force changed during the crash. Use the <strong>Table</strong> tab for exact numbers. <strong>Copy data</strong> lets you paste them into a spreadsheet.</li>
      <li>Press <strong>Reset</strong> to start over. Change one setting at a time. That way you know which change made the difference.</li>
    </ol></div>
  </details>
  <details>
    <summary>Why crumple zones save lives <span class="chev" aria-hidden="true"></span></summary>
    <div class="dbody">
      <p>A moving car has <strong>momentum</strong>. Momentum is mass times velocity. To stop the car, a force must act on it for some time. This push over time is called <strong>impulse</strong>.</p>
      <p><span class="eq">F × Δt = m × Δv</span></p>
      <p>The change in velocity (Δv) is set by the crash. So the only way to make the force smaller is to make the stop take <strong>longer</strong>.</p>
      <p>A <strong>crumple zone</strong> is the front part of the car. It is built to fold up on purpose. While it crushes, the car keeps slowing down a little longer and over a longer distance. That lowers the force.</p>
      <p>The <strong>safety cell</strong> is the strong cage around the people. It should <em>not</em> crush. If the crumple zone is too stiff, too short, or used up, the crash energy pushes into the safety cell instead.</p>
      <p>The <strong>seat belt</strong> and <strong>airbag</strong> do the same job for the person. They stretch and squash so the body slows down over a longer distance. Without them, the dummy keeps moving until it hits the steering wheel. That stop is very short, so the force is huge.</p>
    </div>
  </details>
  <details>
    <summary>Key words <span class="chev" aria-hidden="true"></span></summary>
    <div class="dbody">
      <p><strong>Deceleration</strong>: how fast something slows down, in m/s². Doctors often compare it to gravity: 9.8 m/s² is 1 g.</p>
      <p><strong>Rigidity</strong>: how much force (in kilonewtons, kN) a part can hold before it starts to bend or crush. 1 kN = 1,000 N.</p>
      <p><strong>Stiffness</strong>: how much force it takes to stretch something by one meter. A stiff belt grabs hard. A soft belt stretches more.</p>
      <p><strong>Displacement</strong>: how far something moved from where it started.</p>
      <p><strong>Crash test dummy</strong>: a human-shaped model full of sensors. The black-and-yellow circles are targets that cameras track.</p>
    </div>
  </details>
  <details>
    <summary>About the model <span class="chev" aria-hidden="true"></span></summary>
    <div class="dbody">
      <p>Each crumple zone crushes at a steady force equal to its rigidity. Once it is used up, the safety cell begins to buckle at its selected rigidity. Buckled supports fold more easily, so further energy causes much deeper cabin collapse. Resistance rises again as the crushed structure packs together. In a two-car crash, the weaker structure crushes first.</p>
      <p>This is an illustrative classroom model, not a prediction for a real car. Speed, mass, and structural settings determine the calculated crush; the car drawing and deformation readouts use that same result.</p>
      <p>The dummy has a mass of 75 kg. The belt acts like a spring. The airbag pushes back with a steady force. The steering wheel is 0.45 m in front of the dummy's chest and is very stiff. The head swings about 1.6 times farther than the chest, so without an airbag the head can hit the wheel even when the belt holds the chest.</p>
      <p>Car 2 always has a 70 cm crumple zone (1,000 kN) and a 2,500 kN safety cell. The survival chance is a simple estimate based on the dummy's peak deceleration and safety cell damage. It is not real medical data.</p>
    </div>
  </details>
</section>
</div>

<script>
(() => {
'use strict';
const $ = id => document.getElementById(id);

/* ---------------- theme ---------------- */
const root = document.documentElement;
function systemDark(){ return window.matchMedia && matchMedia('(prefers-color-scheme: dark)').matches; }
function currentTheme(){ return root.dataset.theme || (systemDark() ? 'dark' : 'light'); }
// the script in the head already applied ?theme= (with none, the device's setting decides)
function repaint(){ readColors(); drawAll(); drawGraph(); }
function applyTheme(t){ root.dataset.theme = t; repaint(); }
const inFrame = window.parent !== window;
// the page around this sim switched its light/dark mode: follow it
window.addEventListener('message', e => {
  if (!inFrame || e.source !== window.parent) return;
  const t = e.data && e.data.simTheme;
  if ((t==='light'||t==='dark') && t !== currentTheme()) applyTheme(t);
});
if (window.matchMedia) matchMedia('(prefers-color-scheme: dark)').addEventListener?.('change', repaint);
$('helpBtn').addEventListener('click', () => { const d=$('howto'); d.open=true; d.scrollIntoView({behavior:'smooth',block:'start'}); });

let C = {};
function readColors(){
  const cs = getComputedStyle(root);
  ['bg','surface','surface-2','ink','muted','line','accent','accent-ink','car1','car2','dummy','series2','good','warn','bad','sky','labwall','grid','asphalt','asphalt-line','concrete','glass','interior']
    .forEach(k => C[k] = cs.getPropertyValue('--'+k).trim());
}
readColors();

/* ---------------- car geometry ---------------- */
// local coords: x = meters back from front bumper, y = height above ground (m)
const STYLES = {
  subcompact:{ name:'Subcompact', mass:950, L:3.9, fw:.637, rw:3.246, wr:.334, hip:1.814, paint:{base:'#C87761',light:'#DC9983',shade:'#AD6051',edge:'#74483F'} },
  sedan:{ name:'Compact sedan', mass:1450, L:4.7, fw:.893, rw:3.763, wr:.37, hip:2.186, paint:{base:'#72A7DE',light:'#9DCBF6',shade:'#4681BE',edge:'#285785'} },
  suv:{ name:'SUV', mass:2000, L:4.8, fw:.847, rw:3.883, wr:.443, hip:2.28, paint:{base:'#6AB3B2',light:'#9BD4CC',shade:'#4A9394',edge:'#345D64'} }
};
const CAR2 = { L:.7, cz:1000, cell:2500 };
const CELL = 2.0;      // safety-cell length used for % deformation (m)
const MD = 75;         // dummy mass (kg)
const S_BAG = .18, S_WHEEL = .45;
const EJECTION_SPEED = 26.8; // Explicit animation threshold, not a calibrated injury boundary.

/* crush mapping: rear stays put, front region compresses */
function makeDeform(Lcz, crush){
  const c1 = Math.min(crush, Lcz), cc = Math.max(0, crush - Lcz);
  return x => {
    if (x >= Lcz + CELL) return x;
    if (x >= Lcz) return Lcz + CELL - (Lcz + CELL - x) * (CELL - cc) / CELL;
    if (Lcz <= 0) return Lcz + cc;
    return (Lcz + cc) - (Lcz - x) * (Lcz - c1) / Lcz;
  };
}

/* ---------------- state ---------------- */
const cfg = { style:'sedan', czLen:80, czRig:400, cellRig:2000, belt:true, beltK:80, bag:true, bagR:6,
              mode:'one', v1:16, v2:16, m2:1450, cas:false };
let run = null;          // simulation result
let T = 0;               // playback time
let playing = false, played = false, lastTs = 0;
let tab = 'design', resultsView = 'summary';
const trials = [];

/* ---------------- physics ---------------- */
function mulberry(a){ return () => { a|=0; a=a+0x6D2B79F5|0; let t=Math.imul(a^a>>>15,1|a); t=t+Math.imul(t^t>>>7,61|t)^t; return ((t^t>>>14)>>>0)/4294967296; }; }

// Illustrative force-versus-crush curve (kN, meters), shared by both cars.
// The slider sets the cell's initial buckling load, not an unchanging plateau.
// These teaching-model coefficients are not fitted to a particular vehicle.
function structureForce(crush,Lz,zoneRig,cellRig){
  if(crush<Lz-1e-9)return zoneRig;
  const cellCrush=Math.max(0,crush-Lz);
  const u=Math.min(1,cellCrush/.22),buckled=u*u*(3-2*u);
  const folding=cellRig*(1-.72*buckled);
  // Smooth densification replaces the old abrupt stop at 60% cabin crush.
  const packed=Math.max(0,(cellCrush-CELL*.62)/(CELL*.30));
  return folding+60000*Math.pow(packed,4);
}

function simulate(c){
  const st = STYLES[c.style], m1 = st.mass, two = c.mode==='two';
  const Lz = c.czLen/100, m2 = c.m2;
  const y1 = cr => structureForce(cr,Lz,c.czRig,c.cellRig);
  const y2 = cr => structureForce(cr,CAR2.L,CAR2.cz,CAR2.cell);
  const dt = 2e-5, REC = 25;
  let t=0, p1, w1=-c.v1, c1=0, p2=0, w2= two ? c.v2 : 0, c2=0;
  if (two){ p1 = Math.max(c.v1,.75); p2 = -Math.max(c.v2,.75); } else { p1 = Math.max(c.v1, 1.5); }
  const p1_0=p1, p2_0=p2;
  let sd=0, uD=c.v1;               // dummy forward rel displacement, absolute forward speed
  let contactT=null, crashEndT=null, impactSpeed=0, impactClosing=0, impactX=two?null:0, bagFire=false;
  let maxCarDec=0, maxDumDec=0, maxFd=0, maxS=0, peakST=0, hitWheel=false, hitBag=false, wheelSpeed=0, beltMax=0;
  let accA1=0, accAD=0, accFd=0, accF=0, n=0;
  const frames=[], parts=[]; const rnd = mulberry(7 + Math.round(c.v1*13 + c.czLen));
  let step=0, stopT=null, ejection=null;
  const tLimit = 9;
  while (t < tLimit){
    const front1 = p1 + c1, front2 = two ? p2 - c2 : 0;
    let closing = (two ? w2 : 0) - w1;
    const touching = front1 - front2 <= 1e-9;
    let F = 0;
    if (touching && closing > 1e-9){
      if (contactT===null){
        contactT=t; impactSpeed=-w1; impactClosing=closing; impactX=front1; bagFire = c.bag && closing > 4;
        const severity=Math.min(1,closing/40),drift=two?(w1*m1+w2*m2)/(m1+m2):0;
        for(let k=0;k<Math.round(4+severity*12);k++)parts.push({t:t+rnd()*.05,x:front1+.03,y:.3+rnd()*.7,vx:drift+Math.abs(rnd()-.5)*(2+severity*4),vy:.4+rnd()*(1+severity*2),s:.012+rnd()*.035,col:rnd()<.6?'glass':'car1'});
      }
      const Y1 = y1(c1), Y2 = two ? y2(c2) : Infinity;
      F = Math.min(Y1, Y2);
      const dc = closing*dt;
      if (Y1 < Y2*0.999) c1 += dc; else if (Y2 < Y1*0.999) c2 += dc; else { c1 += dc/2; c2 += dc/2; }
      if (step % 500 === 0 && c1+c2>.08){
        for (let k=0;k<1;k++) parts.push({ t, x: front1, y: .25 + rnd()*.7, vx:(rnd()-.2)*3 + (two? (w1*m1+w2*m2)/(m1+m2) : 0), vy: .4 + rnd()*2,
          s: .02 + rnd()*.04, col: rnd()<.35 ? 'glass' : (two && rnd()<.5 ? 'car2' : (rnd()<.5?'car1':'concrete')) });
      }
    }
    // dummy restraint force (kN, positive = pushes dummy backward)
    const uCar = -w1, vs = uD - uCar;
    let Fd = 0;
    if (c.belt && sd > .02){ const fb = Math.max(0, c.beltK*(sd-.02)*(vs<0?.35:1) + 1.5*vs); Fd += fb; beltMax=Math.max(beltMax,fb); }
    let infl = 0;
    if (bagFire && t >= contactT + .015){ infl = Math.min(1, (t - contactT - .015)/.02)*Math.exp(-Math.max(0,t-contactT-.12)/.22);
      if (sd > S_BAG && infl > .5){ Fd += c.bagR*infl; hitBag = true; } }
    if(!ejection&&!c.belt&&contactT!==null&&impactSpeed>=EJECTION_SPEED&&sd>.34&&vs>4){
      const hipY=st===STYLES.suv?.85:st===STYLES.subcompact?.66:.79;
      ejection={t,x:p1+makeDeform(Lz,c1)(st.L*.36),y:hipY+.72,vx:-Math.min(13,Math.max(8,uD*.48)),vy:3.4+Math.min(1.4,impactSpeed/32)};
      for(let k=0;k<44;k++)parts.push({t,x:ejection.x-.15,y:ejection.y+.1+(rnd()-.5)*.3,vx:ejection.vx*(.2+rnd()*.55),vy:1+rnd()*5,s:.025+rnd()*.06,col:'glass'});
    }
    if(!ejection){
      if (sd > S_WHEEL){ if(!hitWheel){ hitWheel=true; wheelSpeed=vs; } Fd += 4000*(sd-S_WHEEL) + 30*Math.max(0,vs); }
      if (sd < 0){ Fd += 600*sd + 10*Math.min(0,vs); }
    }else Fd=0;
    // car 1 forces (world x, + = right). Car 1 faces left (−x).
    let f1 = F*1000 - Fd*1000;
    if (c.cas && contactT===null && t >= .4 && w1 < 0) f1 += 8*m1;
    if (crashEndT!==null && Math.abs(w1) > 1e-6) f1 += -Math.sign(w1)*6*m1;
    let a1 = f1/m1;
    let a2 = 0;
    if (two){ let f2 = -F*1000; if (crashEndT!==null && Math.abs(w2)>1e-6) f2 += -Math.sign(w2)*6*m2; a2 = f2/m2; }
    if (two && crashEndT!==null){ a1 = a2 = (a1*m1 + a2*m2)/(m1+m2); }
    let nw1 = w1 + a1*dt, nw2 = w2 + a2*dt;
    if (two && crashEndT!==null){ const wc=(m1*w1+m2*w2)/(m1+m2); nw1 = nw2 = wc + a1*dt; if (Math.sign(nw1)!==Math.sign(wc) && wc!==0) nw1 = nw2 = 0; }
    if (crashEndT!==null || (c.cas && contactT===null && t>=.4)){ if (Math.sign(nw1)!==Math.sign(w1) && w1!==0) nw1 = 0; if (two && Math.sign(nw2)!==Math.sign(w2) && w2!==0) nw2=0; }
    if (touching && closing > 1e-9 && ((two?nw2:0) - nw1) <= 0){
      if (two){ const wc=(m1*nw1+m2*nw2)/(m1+m2); nw1=nw2=wc; } else nw1 = 0;
      crashEndT = t;
    }
    a1 = (nw1-w1)/dt; w1=nw1; w2=nw2;
    p1 += w1*dt; if (two) p2 += w2*dt;
    const aF = -a1;                     // car forward accel
    const aD = -Fd*1000/MD;             // dummy forward accel
    uD += aD*dt; sd += (uD - (-w1))*dt;
    if (!ejection&&sd > maxS){ maxS = sd; peakST = t; }
    accA1+=aF; accAD+=aD; accFd+=Fd; accF+=F; n++;
    if (step % REC === 0){
      const fa=accA1/n, fd=accAD/n, ff=accFd/n, fF=accF/n;
      if (contactT!==null){ maxCarDec=Math.max(maxCarDec,-fa); maxDumDec=Math.max(maxDumDec,-fd); maxFd=Math.max(maxFd,ff); }
      frames.push({ t, p1, c1, p2, c2, sd, u:-w1, uD, aF:fa, aD:fd, Fd:ff, F:fF, infl, w2 });
      accA1=accAD=accFd=accF=0; n=0;
    }
    step++; t += dt;
    const settled = Math.abs(w1)<1e-3 && Math.abs(w2)<1e-3;
    if(ejection&&t>ejection.t+2&&settled)break;
    if (crashEndT!==null && t > Math.max(crashEndT, peakST) + .3 && Math.abs(uD + w1) < .05 && settled) break;
    if (contactT===null && Math.abs(w1)<1e-6 && (!two || Math.abs(w2)<1e-6)){ if (stopT===null) stopT=t; if (t > stopT+.5) break; }
  }
  // Keep the settled wreck on screen long enough for suspension and debris to settle.
  const last = frames[frames.length-1];
  if(contactT!==null&&Math.abs(last.u)<.05&&Math.abs(last.w2)<.05&&Math.abs(last.uD)<.1){
    const settleEnd=Math.max(last.t,contactT+1.25);
    for(let tt=last.t+dt*REC;tt<=settleEnd;tt+=dt*REC){
      frames.push({...last,t:tt,infl:last.infl*Math.exp(-(tt-last.t)/.22)});
    }
  }
  const tEnd = frames[frames.length-1].t;
  const crashed = contactT!==null;
  const slowStart = crashed ? contactT - .03 : Infinity;
  const slowEnd = ejection ? ejectionClearTime(ejection) : crashed ? Math.max(crashEndT ?? contactT, peakST) + .12 : -1;
  // results
  const czDef = Math.min(c1, Lz), cellDef = Math.max(0, c1 - Lz);
  const finalU = crashed ? frames.find(f => f.t >= (crashEndT ?? contactT)) : null;
  const dv = crashed ? impactSpeed - (finalU ? finalU.u : 0) : 0;
  const Fmin = crashed ? MD*dv*dv/(2*(Lz + S_WHEEL))/1000 : 0;
  const g = maxDumDec/9.81, cellPct = cellDef/CELL*100;
  let surv = 1/(1+Math.exp((g-60)/7));
  if (cellPct > 12) surv *= Math.max(0, 1 - (cellPct-12)/30);
  const headStrike = !ejection && contactT!==null && !hitBag && !hitWheel && maxS*1.6 > S_WHEEL;
  if (headStrike) surv *= .55;
  if (!crashed) surv = 1;
  return { cfg:{...c}, st, two, frames, parts, dtRec: dt*REC, tEnd, crashed, contactT, crashEndT, peakST, slowStart, slowEnd,
    impactSpeed, impactClosing, impactX, p1_0, p2_0, Lz, m1, m2, ejection,
    czDef, cellDef, cellPct, czPct: Lz>0 ? czDef/Lz*100 : 0, maxS, maxCarDec, maxDumDec, maxFd, Fmin, dv,
    hitWheel, hitBag, headStrike, wheelSpeed, bagFire, surv: ejection?null:Math.round(surv*100), car2Def: c2 };
}

function frameAt(t){
  const fr = run.frames, i = Math.min(fr.length-1, Math.max(0, Math.round(t / run.dtRec)));
  return fr[i];
}

// Presentation-only suspension: initial nose dive, rebound, then damped settling.
// Plastic deformation and all reported forces still come from simulate().
function bodyMotion(t,contactT,severity=1){
  const age=t-contactT;
  if(contactT===null||age<0)return {pitch:0,heave:0,rearLift:0};
  const strength=Math.min(1,Math.max(0,severity)),onset=1-Math.exp(-age/ .025);
  return {pitch:.032*strength*onset*Math.sin(age*12)*Math.exp(-age*3.5),
    heave:-.018*strength*onset*Math.sin(age*12)*Math.exp(-age*4),
    rearLift:.055*strength*onset*Math.max(0,Math.sin(age*12))*Math.exp(-age*4)};
}

// Deformation follows accumulated crush, never elapsed time. Scrubbing or replay
// therefore produces the same permanently folded panels at a given crash state.
function crashShape(st,Lz,crush){
  const smooth=(a,b,v)=>{const u=Math.max(0,Math.min(1,(v-a)/(b-a)));return u*u*(3-2*u);};
  const hoodEnd=st.L*(st===STYLES.suv?.28:.24);
  const hoodFold=smooth(.025,.68,crush),cell=Math.max(0,crush-Lz);
  const cabinFold=smooth(.035,1.5,cell);
  const hinge=.56*hoodEnd;
  const tent=x=>x<0||x>hoodEnd?0:x<hinge?x/hinge:(hoodEnd-x)/(hoodEnd-hinge);
  return {hoodEnd,hoodFold,cell,cabinFold,
    panelX(x,def){
      if(x<=0||x>=hoodEnd)return def(x);
      // Distribute the folded skin between the bumper and the hood hinge rather
      // than collapsing every point onto one vertical line at maximum crush.
      const u=x/hoodEnd,span=def(hoodEnd)-crush;
      const folded=crush+span*u;
      const stack=Math.max(0,.14-span)*Math.sin(Math.PI*u);
      return def(x)+(folded-def(x)+stack)*hoodFold;
    },
    panelOffset(x,y){
      // Cabin crush is longitudinal, through panelX/makeDeform. Keep the roof,
      // windows, doors and floor at their original heights. Only the nose folds
      // vertically; airbag inflation never changes the car's geometry.
      if(x>=hoodEnd)return 0;
      const hoodLine=st===STYLES.sedan?205:175;
      const upper=1-smooth(hoodLine,hoodLine+80,y),nose=1-smooth(.06,hoodEnd,x);
      const ridge=Math.max(0,tent(x));
      // The hood first folds upward, then packs down as the cabin collapses.
      const hood=(.27*hoodFold*(1-.65*cabinFold)+.04*cabinFold)*ridge*upper;
      const packedHood=-.28*cabinFold*upper*(1-smooth(hoodEnd*.6,hoodEnd,x));
      const crease=-.075*hoodFold*Math.exp(-Math.pow((x-hoodEnd*.29)/(.1*hoodEnd),2))*upper;
      const lower=-.07*hoodFold*nose*smooth(260,370,y);
      return hood+packedHood+crease+lower;
    },
    // Suspension/axle damage develops after the nose has used its free space.
    wheelShift:Math.min(.20,Math.max(0,crush-st.fw*.48)*.24),
    wheelDamage:smooth(st.fw*.48,st.fw+ .4,crush)
  };
}

function ejectionClearTime(e){return e.t+1.2/Math.abs(e.vx);}
function playbackRate(r,t){return r.crashed&&t>=r.slowStart&&t<=r.slowEnd?1/15:1;}

const DUMMY_HEAD_PATH='M 62 8 C 34 5 17 20 18 46 L 16 60 L 6 77 Q 4 82 17 83 L 18 91 L 17 100 L 25 115 Q 30 122 44 117 L 58 106 L 67 105 L 84 104 Q 103 82 101 53 Q 104 17 78 10 Z';
function flyingDummyRig(age,settle=0){
  const f=Math.sin(age*15)*.08*(1-settle);
  const mix=(a,b)=>a.map((v,i)=>v+(b[i]-v)*settle);
  const hip=[0,.05],chest=[0,-.35];
  const lk=mix([-.18,.36+f],[-.035,.38]),rk=mix([.26,.30-f],[.08,.37]);
  const lf=mix([-.08,.66],[-.02,.70]),rf=mix([.37,.56],[.07,.69]);
  const le=mix([-.30,-.15-f],[-.10,-.12]),re=mix([.29,-.49+f],[.13,-.13]);
  const lh=mix([-.49,-.35],[-.09,.10]),rh=mix([.48,-.31],[.12,.13]);
  return {
    limbs:[{a:[-.05,.04],b:lk,w:.12},{a:lk,b:lf,w:.09},{a:[.06,.04],b:rk,w:.12},{a:rk,b:rf,w:.09},
      {a:chest,b:hip,w:.23},{a:[-.08,-.36],b:le,w:.085},{a:le,b:lh,w:.07},{a:[.08,-.36],b:re,w:.085},{a:re,b:rh,w:.07}],
    joints:[hip,lk,rk,[-.09,-.35],[.09,-.35],le,re],hands:[lh,rh],shoes:[[lf[0],lf[1]+.04],[rf[0]+.02,rf[1]+.03]]
  };
}
// Use the actual articulated outline as ground support, not a fixed hip height.
function dummyGroundSupport(angle,rig){
  const s=Math.sin(angle),c=Math.cos(angle);let bottom=-Infinity;
  const point=(p,r=0)=>{bottom=Math.max(bottom,p[0]*s+p[1]*c+r);};
  for(const limb of rig.limbs){point(limb.a,limb.w/2+.009);point(limb.b,limb.w/2+.009);}
  rig.joints.forEach(p=>point(p,.05));
  rig.hands.forEach(p=>point(p,Math.hypot(.05*s,.034*c)+.0035));
  for(const p of rig.shoes)for(const dx of [-.045,.105])for(const dy of [-.025,.035])point([p[0]+dx,p[1]+dy]);
  for(const [x,y] of illustrationPoints(DUMMY_HEAD_PATH))point([(x-60)*.0023,-.76+y*.0023],.004);
  return bottom;
}
const ejectionLandings=new WeakMap();
function ejectionFlightTime(e){
  if(ejectionLandings.has(e))return ejectionLandings.get(e);
  const gap=t=>e.y+e.vy*t-11.5*t*t/2-dummyGroundSupport(-Math.PI/2-t*4.6,flyingDummyRig(t));
  let hi=.02;while(hi<3&&gap(hi)>0)hi+=.02;
  let lo=Math.max(0,hi-.02);
  for(let i=0;i<22;i++){const mid=(lo+hi)/2;if(gap(mid)>0)lo=mid;else hi=mid;}
  const result=(lo+hi)/2;ejectionLandings.set(e,result);return result;
}
// Cinematic flight after cabin exit. The restraint data stops at this event.
function ejectionPose(r,t){
  const e=r.ejection;if(!e||t<e.t)return null;
